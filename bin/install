#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
"$ROOT/bin/build"
install -Dm755 "$ROOT/build/windowtuner" "$HOME/.local/bin/windowtuner"
install -Dm644 "$ROOT/pkgbuild/windowtuner.desktop" "$HOME/.local/share/applications/windowtuner.desktop"
install -Dm644 "$ROOT/pkgbuild/windowtuner.svg" "$HOME/.local/share/icons/hicolor/scalable/apps/windowtuner.svg"
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$HOME/.local/share/applications" || true
printf 'Installed WindowTuner. Launch it with Super+Space or: windowtuner\n'
